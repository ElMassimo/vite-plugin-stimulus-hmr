{
  "name": "vite-plugin-stimulus-hmr",
  "type": "module",
  "version": "3.0.0",
  "description": "HMR for Stimulus controllers in Vite.js, tweak your JS without refreshing the page.",
  "author": "Máximo Mussini <maximomussini@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ElMassimo/vite-plugin-stimulus-hmr",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElMassimo/vite-plugin-stimulus-hmr"
  },
  "bugs": "https://github.com/ElMassimo/vite-plugin-stimulus-hmr/issues",
  "keywords": [
    "plugin",
    "hmr",
    "rails",
    "ruby",
    "stimulus",
    "vite",
    "vite-plugin",
    "vitejs"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "vp lint",
    "test": "vitest --config example/vite.config.ts",
    "dev": "vp pack src/index.ts --dts --format esm --watch",
    "example:dev": "npm -C example run dev",
    "example:build": "npm -C example run build",
    "build": "vp pack src/index.ts --dts --format esm",
    "release": "vp pack src/index.ts --dts --format esm && npm publish",
    "prepublishOnly": "npm run build",
    "postpublish": "PACKAGE_VERSION=$(cat package.json | grep \\\"version\\\" | head -1 | awk -F: '{ print $2 }' | sed 's/[\",]//g' | tr -d '[[:space:]]') && git tag v$PACKAGE_VERSION && git push --tags"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "stimulus-vite-helpers": "^3.0.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^22",
    "fast-glob": "^3.3.2",
    "happy-dom": "^17",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^3"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}